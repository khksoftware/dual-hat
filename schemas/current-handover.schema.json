{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://example.invalid/dual-hat/current-handover.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "schema": {
            "const": "dual-hat-current-handover/1.1"
          }
        }
      },
      "then": {
        "required": [
          "active_work_item"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema": {
            "const": "dual-hat-current-handover/1.0"
          }
        }
      },
      "then": {
        "required": [
          "active_capability"
        ]
      }
    }
  ],
  "properties": {
    "active_capability": {
      "deprecated": true,
      "type": [
        "object",
        "null"
      ]
    },
    "active_work_item": {
      "properties": {
        "active_role": {
          "enum": [
            "architecture",
            "engineering",
            "architecture_review"
          ]
        },
        "lifecycle_state": {
          "type": "string"
        },
        "operating_mode": {
          "enum": [
            "integrated",
            "split"
          ]
        },
        "pending_decisions": {
          "type": "array"
        },
        "permitted_next_action": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "work_item_id": {
          "type": "string"
        },
        "work_item_type": {
          "pattern": "^[a-z][a-z0-9_]*$",
          "type": "string"
        },
        "work_order_hash": {
          "pattern": "^[A-F0-9]{64}$",
          "type": "string"
        },
        "work_order_revision": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "work_item_id",
        "work_item_type",
        "title",
        "operating_mode",
        "active_role",
        "lifecycle_state",
        "work_order_revision",
        "work_order_hash",
        "pending_decisions",
        "permitted_next_action"
      ],
      "type": [
        "object",
        "null"
      ]
    },
    "authorization_boundaries": {
      "type": "array"
    },
    "commit_roles": {
      "required": [
        "starting",
        "implementation",
        "corrected",
        "detached_validation",
        "closure_evidence",
        "generation_input",
        "final_published"
      ],
      "type": "object"
    },
    "external_repositories": {
      "type": "array"
    },
    "identity": {
      "minLength": 1,
      "type": "string"
    },
    "latest_completed_capability": {
      "type": [
        "object",
        "null"
      ]
    },
    "next_allowed_work": {
      "type": "array"
    },
    "phase_or_release": {
      "type": "object"
    },
    "protected_assets": {
      "type": "array"
    },
    "repository": {
      "additionalProperties": false,
      "properties": {
        "branch": {
          "type": "string"
        },
        "clean": {
          "type": "boolean"
        },
        "head": {
          "type": "string"
        },
        "origin_head": {
          "type": "string"
        }
      },
      "required": [
        "branch",
        "head",
        "origin_head",
        "clean"
      ],
      "type": "object"
    },
    "schema": {
      "enum": [
        "dual-hat-current-handover/1.0",
        "dual-hat-current-handover/1.1"
      ]
    },
    "unresolved_decisions": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "identity",
    "repository",
    "latest_completed_capability",
    "phase_or_release",
    "commit_roles",
    "external_repositories",
    "protected_assets",
    "unresolved_decisions",
    "authorization_boundaries",
    "next_allowed_work"
  ],
  "title": "Dual Hat current handover",
  "type": "object"
}
