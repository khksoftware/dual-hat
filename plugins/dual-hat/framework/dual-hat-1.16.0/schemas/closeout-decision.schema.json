{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://example.invalid/dual-hat/closeout-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "advisory_three_item_threshold_reached": {
      "type": "boolean"
    },
    "continuity_evidence": {
      "required": [
        "architecture_directed",
        "next_stream",
        "source"
      ],
      "type": "object"
    },
    "counter_forced_full_closure": {
      "const": false
    },
    "full_closure_triggers": {
      "type": "array"
    },
    "publication_authorized": {
      "type": "boolean"
    },
    "required_lightweight_evidence": {
      "type": "array"
    },
    "same_stream_next": {
      "type": "boolean"
    },
    "schema": {
      "const": "dual-hat-closeout-decision/1.0"
    },
    "selection": {
      "enum": [
        "lightweight_continuity",
        "full"
      ]
    },
    "skipped_when_lightweight": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "selection",
    "full_closure_triggers",
    "advisory_three_item_threshold_reached",
    "counter_forced_full_closure",
    "same_stream_next",
    "continuity_evidence",
    "publication_authorized",
    "required_lightweight_evidence",
    "skipped_when_lightweight"
  ],
  "type": "object"
}
