{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://dual-hat.example/schemas/export-manifest/3.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authority": {
      "minLength": 1,
      "type": "string"
    },
    "binary_attestations": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "content_type": {
            "minLength": 1,
            "type": "string"
          },
          "distribution_rule": {
            "const": "include"
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "provenance": {
            "minLength": 1,
            "type": "string"
          },
          "purpose": {
            "minLength": 1,
            "type": "string"
          },
          "retention_rule": {
            "minLength": 1,
            "type": "string"
          },
          "review_evidence": {
            "minLength": 1,
            "type": "string"
          },
          "rights_basis": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[A-F0-9]{64}$",
            "type": "string"
          },
          "size_bytes": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "content_type",
          "purpose",
          "provenance",
          "sha256",
          "size_bytes",
          "rights_basis",
          "review_evidence",
          "retention_rule",
          "distribution_rule"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "content_files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "bytes": {
            "minimum": 0,
            "type": "integer"
          },
          "license": {
            "const": "Apache-2.0"
          },
          "mode": {
            "const": "100644"
          },
          "origin": {
            "enum": [
              "canonical_source",
              "generated"
            ]
          },
          "path": {
            "minLength": 1,
            "type": "string"
          },
          "sha256": {
            "pattern": "^[A-F0-9]{64}$",
            "type": "string"
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes",
          "mode",
          "license",
          "origin"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "control_file_count": {
      "const": 2
    },
    "copied_file_count": {
      "minimum": 1,
      "type": "integer"
    },
    "drift_policy": {
      "minLength": 1,
      "type": "string"
    },
    "excluded_canonical_control_count": {
      "const": 2
    },
    "framework": {
      "const": "Dual Hat"
    },
    "generated_content_file_count": {
      "const": 1
    },
    "license_expression": {
      "const": "Apache-2.0"
    },
    "license_sha256": {
      "pattern": "^[A-F0-9]{64}$",
      "type": "string"
    },
    "notice_sha256": {
      "pattern": "^[A-F0-9]{64}$",
      "type": "string"
    },
    "previous_export_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "const": "dual-hat-export-manifest/3.0"
    },
    "source_commit": {
      "oneOf": [
        {
          "pattern": "^[0-9a-f]{40}$",
          "type": "string"
        },
        {
          "const": "WORKING-TREE-UNCOMMITTED"
        }
      ]
    },
    "source_provenance_state": {
      "enum": [
        "verified_committed_tree",
        "uncommitted_working_tree_preview_not_publishable"
      ]
    },
    "third_party_notice_sha256": {
      "pattern": "^[A-F0-9]{64}$",
      "type": "string"
    },
    "total_file_count": {
      "minimum": 4,
      "type": "integer"
    },
    "tree_sha256": {
      "pattern": "^[A-F0-9]{64}$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "framework",
    "license_expression",
    "source_commit",
    "source_provenance_state",
    "content_files",
    "binary_attestations",
    "copied_file_count",
    "generated_content_file_count",
    "control_file_count",
    "total_file_count",
    "excluded_canonical_control_count",
    "tree_sha256",
    "previous_export_identity",
    "license_sha256",
    "notice_sha256",
    "third_party_notice_sha256",
    "authority",
    "drift_policy"
  ],
  "title": "Dual Hat deterministic export manifest",
  "type": "object"
}
