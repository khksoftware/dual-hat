{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://example.invalid/dual-hat/closeout-decision.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "advisory_three_item_threshold_reached": {
      "type": "boolean"
    },
    "continuity_evidence": {
      "required": [
        "architecture_directed",
        "next_stream",
        "source"
      ],
      "type": "object"
    },
    "counter_forced_full_closure": {
      "const": false
    },
    "dispatch_inventory": {
      "additionalProperties": false,
      "properties": {
        "blocking_workers": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "closure_authorized": {
          "type": "boolean"
        },
        "nonterminal_count": {
          "minimum": 0,
          "type": "integer"
        },
        "registered_count": {
          "minimum": 0,
          "type": "integer"
        },
        "schema": {
          "const": "dual-hat-dispatch-inventory/1.0"
        },
        "terminal_count": {
          "minimum": 0,
          "type": "integer"
        },
        "unregistered_dispatch_detectable": {
          "const": false
        },
        "workers": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "assigned_outcome": {
                "minLength": 1,
                "type": "string"
              },
              "durable_cursor": {
                "minLength": 1,
                "type": "string"
              },
              "handle": {
                "minLength": 1,
                "type": "string"
              },
              "heartbeat_interval_seconds": {
                "exclusiveMinimum": 0,
                "type": "number"
              },
              "last_probe_age_seconds": {
                "minimum": 0,
                "type": "number"
              },
              "outcome_complete": {
                "type": "boolean"
              },
              "owner": {
                "minLength": 1,
                "type": "string"
              },
              "state": {
                "enum": [
                  "running",
                  "unreachable",
                  "stalled",
                  "dead",
                  "finished"
                ]
              },
              "successor_handle": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "terminal_evidence": {
                "type": "string"
              }
            },
            "required": [
              "handle",
              "assigned_outcome",
              "owner",
              "durable_cursor",
              "heartbeat_interval_seconds",
              "last_probe_age_seconds",
              "state",
              "outcome_complete"
            ],
            "type": "object"
          },
          "type": "array"
        }
      },
      "required": [
        "schema",
        "workers",
        "registered_count",
        "terminal_count",
        "nonterminal_count",
        "blocking_workers",
        "closure_authorized",
        "unregistered_dispatch_detectable"
      ],
      "type": "object"
    },
    "full_closure_triggers": {
      "type": "array"
    },
    "publication_authorized": {
      "type": "boolean"
    },
    "reconciliation_audit": {
      "additionalProperties": false,
      "properties": {
        "blocking_items": {
          "type": "array"
        },
        "closure_authorized": {
          "type": "boolean"
        },
        "engineering_self_report_only": {
          "const": false
        },
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "author_deferred": {
                "type": "boolean"
              },
              "description": {
                "minLength": 1,
                "type": "string"
              },
              "evidence": {
                "minLength": 1,
                "type": "string"
              },
              "source": {
                "enum": [
                  "sealed_scope",
                  "incremental_request",
                  "interim_finding"
                ]
              },
              "status": {
                "enum": [
                  "done",
                  "partial",
                  "not_done"
                ]
              }
            },
            "required": [
              "source",
              "description",
              "status",
              "evidence"
            ],
            "type": "object"
          },
          "minItems": 1,
          "type": "array"
        },
        "reviewer_role": {
          "const": "independent"
        },
        "schema": {
          "const": "dual-hat-reconciliation-audit/1.0"
        }
      },
      "required": [
        "schema",
        "reviewer_role",
        "engineering_self_report_only",
        "items",
        "blocking_items",
        "closure_authorized"
      ],
      "type": "object"
    },
    "required_lightweight_evidence": {
      "type": "array"
    },
    "same_stream_next": {
      "type": "boolean"
    },
    "schema": {
      "const": "dual-hat-closeout-decision/1.0"
    },
    "selection": {
      "enum": [
        "lightweight_continuity",
        "full"
      ]
    },
    "skipped_when_lightweight": {
      "type": "array"
    }
  },
  "required": [
    "schema",
    "selection",
    "full_closure_triggers",
    "advisory_three_item_threshold_reached",
    "counter_forced_full_closure",
    "same_stream_next",
    "continuity_evidence",
    "publication_authorized",
    "required_lightweight_evidence",
    "skipped_when_lightweight",
    "reconciliation_audit",
    "dispatch_inventory"
  ],
  "type": "object"
}
