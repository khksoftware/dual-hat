{
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "$id": "https://dual-hat.local/schemas/quality-rule-sources.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "dual-hat-quality-rule-sources/1.0"
    },
    "sources": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "privacy": {
            "enum": [
              "governed",
              "private"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "source_id": {
            "type": "string"
          }
        },
        "required": [
          "source_id",
          "path",
          "required"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "schema",
    "sources"
  ],
  "type": "object"
}
